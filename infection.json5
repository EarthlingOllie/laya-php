{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    // Infection no longer has a Pest adapter, so its PHPUnit adapter drives Pest through
    // tools/pest-for-infection.php (see that file for what it bridges). The default suites
    // from phpunit.xml.dist are used, so Integration (live Laya server) never runs here.
    "testFramework": "phpunit",
    "phpUnit": {
        "customPath": "tools/pest-for-infection.php"
    },
    "tmpDir": "build/infection/tmp",
    "logs": {
        "text": "build/infection/infection.log",
        "summary": "build/infection/summary.log"
    },
    "mutators": {
        "@default": true,
        // file_get_contents() and stream_get_contents() return false only when the read fails, after
        // TryCommand::text() has checked the file or opened stdin. The casts turn that false into '',
        // which Context::text() then refuses as empty text; no test can make an existing, readable
        // file or an open stdin fail to read.
        "CastString": {
            "ignore": ["EarthlingOllie\\SystemOneClassification\\Laravel\\Commands\\TryCommand::text"]
        }
    },
    // Run with --with-uncovered (see `composer mutate`) so that uncovered code counts
    // against the MSI instead of being skipped.
    "minMsi": 90,
    "minCoveredMsi": 100
}
