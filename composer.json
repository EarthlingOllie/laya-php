{
    "name": "earthlingollie/laravel-system-one-classification",
    "description": "A typed, immutable Laravel client for System 1 decision models (Laya, Jev and compatible models).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "laya",
        "jev",
        "system-one",
        "classification"
    ],
    "require": {
        "php": "^8.4",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "infection/infection": "^0.35.8",
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^3.8.7",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "EarthlingOllie\\SystemOneClassification\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EarthlingOllie\\SystemOneClassification\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EarthlingOllie\\SystemOneClassification\\Laravel\\SystemOneServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G --no-progress",
        "check": [
            "@format:check",
            "@analyse",
            "@test",
            "@test:coverage",
            "@mutate"
        ],
        "format": "@php vendor/bin/pint",
        "format:check": "@php vendor/bin/pint --test",
        "mutate": "@php tools/mutate.php --threads=max --with-uncovered --show-mutations --no-progress",
        "post-autoload-dump": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "serve": [
            "@php vendor/bin/testbench package:discover --ansi",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "test": "@php vendor/bin/pest",
        "test:coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "@php -r \"@unlink('build/coverage/coverage.cov');\"",
            "@php vendor/bin/pest --path-coverage --coverage-php=build/coverage/coverage.cov --coverage-clover=build/coverage/clover.xml",
            "@php tools/check-coverage.php build/coverage/coverage.cov"
        ],
        "test:integration": "@php vendor/bin/pest --testsuite=Integration"
    },
    "scripts-descriptions": {
        "analyse": "PHPStan at max level with strict rules, including the assertType() files in tests/Types.",
        "check": "Run every quality gate, as CI does.",
        "format": "Fix code style with Laravel Pint.",
        "format:check": "Check code style with Laravel Pint without changing files.",
        "mutate": "Infection mutation testing (MSI >= 90, covered MSI 100).",
        "serve": "Serve the workbench app (testbench.yaml) with the package auto-discovered; set SERVER_PORT/SERVER_HOST to change the address.",
        "test": "Unit, Contract, Feature and Arch suites.",
        "test:coverage": "Tests with Xdebug path coverage; fails below 100% of lines or branches of src/.",
        "test:integration": "Integration suite against a running Laya server."
    },
    "config": {
        "process-timeout": 0,
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
