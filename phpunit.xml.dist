<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         defaultTestSuite="Unit,Contract,Feature,Arch"
         failOnRisky="true"
         failOnWarning="true"
         failOnDeprecation="true"
         failOnPhpunitDeprecation="true"
         failOnNotice="true"
         beStrictAboutOutputDuringTests="true"
         beStrictAboutCoverageMetadata="false"
         requireCoverageMetadata="false"
         executionOrder="random"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerWarnings="true">
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">tests/Unit</directory>
        </testsuite>
        <testsuite name="Contract">
            <directory suffix="Test.php">tests/Contract</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">tests/Feature</directory>
        </testsuite>
        <testsuite name="Arch">
            <directory suffix="Test.php">tests/Arch</directory>
        </testsuite>
        <!-- Needs a running Laya server (docker). Not in the default suite: run `composer test:integration`. -->
        <testsuite name="Integration">
            <directory suffix="Test.php">tests/Integration</directory>
        </testsuite>
        <!-- Real hosted Laya and Jev, billed per call; each test skips without its key. Never in the default suite or CI: `composer test:smoke`, or the manual smoke workflow. -->
        <testsuite name="Smoke">
            <directory suffix="Test.php">tests/Smoke</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Throwaway key so workbench web routes (encrypted cookies) work in tests. -->
        <env name="APP_KEY" value="base64:8qYkwXk2TVuV1M/nj61QQOG33ogSpXeXNV0TVSbr/kQ="/>
    </php>
</phpunit>
