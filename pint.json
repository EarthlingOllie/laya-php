{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": true,
        "strict_comparison": true,
        "strict_param": true,
        "global_namespace_import": {
            "import_classes": true,
            "import_constants": false,
            "import_functions": false
        },
        "ordered_class_elements": true
    },
    "exclude": [
        "build",
        "workbench/bootstrap/cache"
    ]
}
