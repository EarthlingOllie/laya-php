{
  "scenario": "unauthorized_bad_key",
  "description": "A wrong bearer key.",
  "request": {
    "method": "POST",
    "path": "/v1/systemone",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer <wrong-key>"
    },
    "body": {
      "state": "Hi, we were billed twice for March. Please refund the duplicate charge today or we will cancel our plan.",
      "questions": {
        "churn": {
          "type": "noul",
          "instructions": "Does the customer threaten to cancel or leave?"
        }
      }
    }
  },
  "response": {
    "status": 401,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "detail": "invalid or missing bearer token"
    }
  }
}
