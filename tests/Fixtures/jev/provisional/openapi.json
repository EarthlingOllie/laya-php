{
  "openapi": "3.1.0",
  "info": {
    "title": "PROVISIONAL stand-in for Jev's OpenAPI document (not fetched from TypeSafe)",
    "version": "0.0.0-provisional",
    "description": "Written by hand from what is recorded, because api.typesafe.ai/openapi.json could not be fetched (see README.md next to this file). It describes only the POST /v1/systemone request body, as laya-ai.com/laya-api documents it and as laya-serve 0.4.8 (which says it speaks Jev's protocol) accepted it in tests/Fixtures/laya. Replace it with the real document: bin/fetch-jev-openapi.",
    "x-provisional": true
  },
  "paths": {
    "/v1/systemone": {
      "post": {
        "summary": "One decision: a state and its questions",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SystemOneRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "The answers" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SystemOneRequest": {
        "type": "object",
        "required": ["state", "questions"],
        "additionalProperties": false,
        "properties": {
          "state": {
            "anyOf": [
              { "type": "string", "minLength": 1 },
              { "type": "object" }
            ]
          },
          "questions": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "$ref": "#/components/schemas/Question" }
          },
          "model": { "type": "string", "minLength": 1 },
          "lang": { "type": "string" },
          "lang_guess": { "type": "boolean" },
          "min_confidence": {
            "anyOf": [
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 } }
            ]
          },
          "max_len": { "type": "integer", "minimum": 1 },
          "head_max_len": { "type": "integer", "minimum": 1 },
          "task": { "type": "string" }
        }
      },
      "Question": {
        "oneOf": [
          { "$ref": "#/components/schemas/NoulQuestion" },
          { "$ref": "#/components/schemas/ChoiceQuestion" },
          { "$ref": "#/components/schemas/ScoreQuestion" }
        ]
      },
      "NoulQuestion": {
        "type": "object",
        "required": ["type", "instructions"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "noul" },
          "instructions": { "type": "string", "minLength": 1 }
        }
      },
      "ChoiceQuestion": {
        "type": "object",
        "required": ["type", "instructions", "criteria"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "choice" },
          "instructions": { "type": "string", "minLength": 1 },
          "criteria": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 255,
            "additionalProperties": { "type": ["string", "null"] }
          }
        }
      },
      "ScoreQuestion": {
        "type": "object",
        "required": ["type", "instructions", "criteria"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "score" },
          "instructions": { "type": "string", "minLength": 1 },
          "criteria": {
            "type": "array",
            "minItems": 1,
            "items": { "type": ["string", "null"] }
          }
        }
      }
    }
  }
}
